# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-firefox
dist-chrome
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files
.env
.env.*
!.env.example
# Holds no secret — just pins the distribution Firefox/Chrome/Edge builds to the
# production API so they can't inherit a developer's localhost .env.
!.env.firefox
!.env.chrome

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.claude/

# Generated lesson assets — synced from content/ by the frontend prebuild hook.
# Tracking these caused churn on every content change; Vercel regenerates them.
frontend/public/content/
# Generated sitemap — emitted by the frontend prebuild hook (sync-content).
frontend/public/sitemap.xml

# Local staging for lesson images — uploaded to Supabase 'lesson-images' bucket, never committed
_image-staging/

# Repo archives + one-off throwaway content-patch scripts (not product code).
# Convention: the repo root and content/ hold no product .py files except
# content/validate.py and content/scripts/ — anything else is a throwaway
# patch script and should never enter git.
*.zip
*.log.*
/*.py
content/*.py
!content/validate.py
!content/validate_career_templates.py
content/roadmaps/**/*.py

# AMO upload artifacts (rebuildable via scripts/pack-amo.mjs)
extension/submit/
