        {
          "stable_key": "sys.tcp_ip_basics",
          "title": "TCP/IP Basics",
          "est_effort_min": 60,
          "priority": 4,
          "depends_on": [],
          "diagnostic_probe": "Why does TCP guarantee delivery while UDP doesn't?",
          "diagnostic_answer": "TCP establishes a connection and tracks acknowledgments for every packet, retransmitting anything lost — that bookkeeping is what guarantees delivery. UDP sends packets with no connection or acknowledgment tracking at all, so it's faster but delivery isn't guaranteed."
        },
        {
          "stable_key": "sys.http_basics",
          "title": "HTTP Basics",
          "est_effort_min": 60,
          "priority": 5,
          "depends_on": ["sys.tcp_ip_basics"],
          "diagnostic_probe": "What does a 500 status code tell you versus a 400?",
          "diagnostic_answer": "A 5xx code means the SERVER failed to fulfill a valid request (its own fault — a bug or outage). A 4xx code means the CLIENT'S request itself was invalid or couldn't be fulfilled as sent (bad input, missing auth, wrong resource)."
        },
        {
