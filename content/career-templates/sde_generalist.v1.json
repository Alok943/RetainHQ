          "stable_key": "core.recursion",
          "title": "Recursion",
          "est_effort_min": 90,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "What are the two essential parts of any correct recursive function?",
          "diagnostic_answer": "A base case that stops the recursion without calling itself again, and a recursive case that calls the function on a smaller version of the problem, making progress toward the base case."
        },
