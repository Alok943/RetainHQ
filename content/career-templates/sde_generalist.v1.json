        {
          "stable_key": "oop.inheritance_vs_composition",
          "title": "Inheritance vs Composition",
          "est_effort_min": 75,
          "priority": 5,
          "depends_on": ["oop.classes_and_objects"],
          "diagnostic_probe": "Why is 'favor composition over inheritance' common advice?",
          "diagnostic_answer": "Inheritance creates a tight, rigid coupling between parent and child classes (changing the parent can break every subclass) and can lead to fragile, deep hierarchies. Composition builds behavior by combining smaller, independent objects, which is more flexible and easier to change later."
        },
        {
