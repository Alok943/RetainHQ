      "nodes": [
        {
          "stable_key": "oop.classes_and_objects",
          "title": "Classes & Objects",
          "est_effort_min": 60,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "What's the difference between a class and an instance?",
          "diagnostic_answer": "A class is the blueprint/template defining what fields and methods something has. An instance (object) is one concrete thing created from that blueprint, with its own actual field values in memory."
        },
        {
          "stable_key": "oop.encapsulation_abstraction",
