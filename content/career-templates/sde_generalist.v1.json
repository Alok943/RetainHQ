          "stable_key": "db.sql_fundamentals",
          "title": "SQL Fundamentals",
          "est_effort_min": 90,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "What clause filters rows BEFORE grouping, versus the clause that filters AFTER grouping?",
          "diagnostic_answer": "WHERE filters individual rows BEFORE any grouping happens. HAVING filters entire groups AFTER GROUP BY has aggregated them — you'd use HAVING to filter on an aggregate value like COUNT(*) or SUM(...)."
        },
        {
          "stable_key": "db.joins",
          "title": "SQL Joins",
          "est_effort_min": 75,
          "priority": 5,
          "depends_on": ["db.sql_fundamentals"],
          "diagnostic_probe": "What does a LEFT JOIN return that an INNER JOIN doesn't?",
          "diagnostic_answer": "A LEFT JOIN returns every row from the left table regardless of whether it has a match, filling unmatched right-table columns with NULL. An INNER JOIN only returns rows that have a match in both tables, dropping unmatched rows entirely."
        },
