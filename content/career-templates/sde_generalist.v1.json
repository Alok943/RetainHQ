        {
          "stable_key": "sys.processes_and_threads",
          "title": "Processes & Threads",
          "est_effort_min": 60,
          "priority": 4,
          "depends_on": [],
          "diagnostic_probe": "What's the main difference between a process and a thread?",
          "diagnostic_answer": "A process has its own isolated memory space; threads within the same process share that memory space but each have their own stack, making threads lighter-weight to create and switch between, at the cost of needing synchronization for shared data."
        },
        {
          "stable_key": "sys.concurrency_basics",
          "title": "Concurrency Basics",
          "est_effort_min": 75,
