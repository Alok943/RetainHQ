  "subjects": [
    {
      "key": "dsa",
      "title": "Data Structures & Algorithms",
      "default_priority": 5,
      "nodes": [
        {
          "stable_key": "dsa.arrays.basics",
          "title": "Arrays & Time Complexity",
          "est_effort_min": 60,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "What is the time complexity of accessing an element by index in an array, and of inserting at the front?",
          "diagnostic_answer": "Indexing by position is O(1) — arrays are contiguous memory, so the address is computed directly. Inserting at the front is O(n) because every existing element must shift right by one."
        },
        {
          "stable_key": "dsa.arrays.two_pointers",
          "title": "Two Pointers",
          "est_effort_min": 90,
          "priority": 4,
          "depends_on": ["dsa.arrays.basics"],
          "diagnostic_probe": "Given a sorted array, find two numbers summing to a target in O(n).",
          "diagnostic_answer": "Use two pointers, one at each end. If the sum is too large, move the right pointer left; if too small, move the left pointer right; if it matches, stop. Each step discards at least one candidate, so it's O(n) with O(1) extra space — no need for a hash set."
        },
        {
          "stable_key": "dsa.arrays.sliding_window",
          "title": "Sliding Window",
          "est_effort_min": 90,
          "priority": 4,
          "depends_on": ["dsa.arrays.two_pointers"]
        },
        {
          "stable_key": "dsa.strings.basics",
          "title": "String Manipulation",
          "est_effort_min": 60,
          "priority": 3,
          "depends_on": ["dsa.arrays.basics"]
        },
        {
          "stable_key": "dsa.hashing.hashmaps",
          "title": "Hash Maps & Sets",
          "est_effort_min": 90,
          "priority": 5,
          "depends_on": ["dsa.arrays.basics"],
          "diagnostic_probe": "Why is average-case hash map lookup O(1), and when does it degrade to O(n)?",
          "diagnostic_answer": "A good hash function spreads keys evenly across buckets, so each bucket holds ~O(1) items on average. It degrades to O(n) when many keys collide into the same bucket (a poor hash function, or adversarial input), turning the bucket into a linear scan."
        },
        {
          "stable_key": "dsa.linked_lists.basics",
          "title": "Linked Lists",
          "est_effort_min": 75,
          "priority": 4,
          "depends_on": []
        },
        {
          "stable_key": "dsa.stacks_queues",
          "title": "Stacks & Queues",
          "est_effort_min": 75,
          "priority": 4,
          "depends_on": []
        },
        {
          "stable_key": "dsa.recursion.basics",
          "title": "Recursion & Backtracking",
          "est_effort_min": 90,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "Write the recurrence for factorial and identify its base case.",
          "diagnostic_answer": "factorial(n) = n * factorial(n-1) for n > 0, with base case factorial(0) = 1. Without the base case the recursion never terminates."
        },
        {
          "stable_key": "dsa.trees.binary_trees",
          "title": "Binary Trees & Traversals",
          "est_effort_min": 120,
          "priority": 5,
          "depends_on": ["dsa.recursion.basics"],
          "diagnostic_probe": "What's the difference between in-order, pre-order, and post-order traversal?",
          "diagnostic_answer": "In-order visits left subtree, then the node, then right subtree (yields sorted order for a BST). Pre-order visits the node first, then left, then right. Post-order visits left, then right, then the node last."
        },
        {
          "stable_key": "dsa.trees.bst",
          "title": "Binary Search Trees",
          "est_effort_min": 90,
          "priority": 4,
          "depends_on": ["dsa.trees.binary_trees"]
        },
        {
          "stable_key": "dsa.graphs.bfs_dfs",
          "title": "Graph Traversal: BFS & DFS",
          "est_effort_min": 120,
          "priority": 5,
          "depends_on": ["dsa.stacks_queues", "dsa.trees.binary_trees"],
          "diagnostic_probe": "When would you use BFS over DFS to find the shortest path in an unweighted graph?",
          "diagnostic_answer": "BFS explores level-by-level, so the first time it reaches a node is guaranteed to be via the fewest edges — it finds shortest paths in an unweighted graph. DFS explores one path fully before backtracking and offers no such guarantee."
        },
        {
          "stable_key": "dsa.graphs.shortest_path",
          "title": "Shortest Path (Dijkstra)",
          "est_effort_min": 120,
          "priority": 3,
          "depends_on": ["dsa.graphs.bfs_dfs"]
        },
        {
          "stable_key": "dsa.dp.basics",
          "title": "Dynamic Programming Basics",
          "est_effort_min": 150,
          "priority": 5,
          "depends_on": ["dsa.recursion.basics"],
          "diagnostic_probe": "What makes a problem a good candidate for memoization?",
          "diagnostic_answer": "The problem has overlapping subproblems (the same subproblem recurs many times in the naive recursive solution) and optimal substructure (the optimal solution is built from optimal solutions to subproblems). Memoization caches subproblem results so each is computed once."
        },
        {
          "stable_key": "dsa.sorting.comparison_sorts",
          "title": "Sorting Algorithms",
          "est_effort_min": 60,
          "priority": 3,
          "depends_on": ["dsa.arrays.basics"]
        },
        {
          "stable_key": "dsa.searching.binary_search",
          "title": "Binary Search",
          "est_effort_min": 60,
          "priority": 4,
          "depends_on": ["dsa.arrays.basics"]
        }
      ]
    },
