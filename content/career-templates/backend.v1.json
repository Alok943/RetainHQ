          "title": "HTTP/HTTPS",
          "est_effort_min": 60,
          "priority": 5,
          "depends_on": ["net.tcp_ip_basics"],
          "diagnostic_probe": "What HTTP status code range indicates a client error, and what does 404 mean?",
          "diagnostic_answer": "4xx indicates a client error (the request itself is wrong or can't be fulfilled as sent). 404 specifically means 'Not Found' — the server couldn't find a resource matching the requested URL."
        },
