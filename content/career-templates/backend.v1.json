          "stable_key": "net.tcp_ip_basics",
          "title": "TCP/IP Basics",
          "est_effort_min": 60,
          "priority": 4,
          "depends_on": [],
          "diagnostic_probe": "What's the difference between TCP and UDP, and when would you pick one over the other?",
          "diagnostic_answer": "TCP is connection-oriented, reliable, and ordered (retransmits lost packets) — use it when correctness matters (web pages, file transfer, APIs). UDP is connectionless and unreliable but lower-latency — use it when speed matters more than guaranteed delivery (video calls, gaming, DNS)."
        },
