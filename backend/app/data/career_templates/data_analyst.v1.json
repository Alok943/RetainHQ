          "stable_key": "sql_advanced.row_number_rank",
          "title": "ROW_NUMBER, RANK, DENSE_RANK",
          "est_effort_min": 60,
          "priority": 5,
          "depends_on": [
            "sql_core.select_filtering"
          ],
          "diagnostic_probe": "How do RANK() and DENSE_RANK() differ when two rows tie for 2nd place?",
          "diagnostic_answer": "RANK() leaves gaps in sequence (assigning 1, 2, 2, 4 for the next row). DENSE_RANK() assigns consecutive ranks without gaps (assigning 1, 2, 2, 3)."
        },
