          "est_effort_min": 45,
          "priority": 5,
          "depends_on": [],
          "diagnostic_probe": "What is the execution order between WHERE, GROUP BY, and HAVING in SQL?",
          "diagnostic_answer": "WHERE filters individual rows before grouping occurs. GROUP BY aggregates the remaining rows into groups. HAVING filters the grouped aggregations after GROUP BY has run."
        },
